{
  "name": "asistencia-tmt-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/inicio.ts",
    "start": "tsx --env-file=.env src/inicio.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:iniciar": "node scripts/postgres.mjs iniciar",
    "db:detener": "node scripts/postgres.mjs detener",
    "db:migrar": "tsx --env-file=.env scripts/migrar.ts",
    "db:admin-inicial": "tsx --env-file=.env scripts/crear-admin.ts",
    "db:crear-admin": "tsx --env-file=.env scripts/crear-admin.ts",
    "db:cambiar-dni": "tsx --env-file=.env scripts/cambiar-dni.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "argon2": "^0.45.2",
    "croner": "^11.0.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
